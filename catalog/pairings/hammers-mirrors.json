    "everyday": {
      "label": "Everyday workhorse",
      "note": "Under-$40 hammers and under-$250 mirrors people actually buy for a Saturday project."
    },
    "heirloom": {
      "label": "Heirloom / high-end",
      "note": "Hand-forged, Japanese, Swedish, solid-brass, hand-gilded: things with a maker and a story."
    },
    "vintage": {
      "label": "Vintage & historical",
      "note": "Old tools with patina, mid-century and antique mirrors. Mostly eBay / Etsy / Chairish."
    },
    "oddball": {
      "label": "Oddballs",
      "note": "Geologist's picks, chasing hammers, convex safety mirrors: the quirky picks the story loves."
    }
